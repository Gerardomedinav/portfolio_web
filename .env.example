# Configuración del Proveedor Principal de IA para GerAssist
# Proveedores en cascada: gemini -> groq -> openrouter -> ollama -> anthropic

AI_PROVIDER=gemini
AI_API_KEY=tu_api_key_de_google_ai_studio_aqui
GEMINI_MODEL=gemini-flash-latest

# Configuración de Proveedores Secundarios de Respaldo (Fallback Automático)
GROQ_API_KEY=opcional_tu_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=opcional_tu_openrouter_api_key
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# Configuración de Ollama Local (IA 100% Gratuita y Offline)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
